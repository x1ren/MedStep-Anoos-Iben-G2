# ---------------------------------------------------------------
# MedStep environment variables
# Copy this file to `.env` and replace the dummy values.
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows cmd / PowerShell)
# NEVER commit your real .env file.
# ---------------------------------------------------------------

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated, scheme required (only needed when deployed behind HTTPS)
CSRF_TRUSTED_ORIGINS=

# --- Supabase PostgreSQL ---
# Option A: a single connection string (takes precedence when set).
# Supabase Dashboard -> Project -> Connect -> "Session pooler" (IPv4-friendly):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Option B: individual credentials (used when DATABASE_URL is empty/unset).
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
# Supabase requires SSL
DB_SSLMODE=require
# Seconds to keep DB connections open (0 = close after each request)
DB_CONN_MAX_AGE=60

# --- Simulator ---
# Seconds before a learner can save another attempt on the same scenario (0 = off)
ATTEMPT_COOLDOWN_SECONDS=10
