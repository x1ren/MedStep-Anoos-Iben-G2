# ---------------------------------------------------------------
# MedStep .gitignore
# ---------------------------------------------------------------

# Secrets / environment
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.so

# Django
media/
staticfiles/
*.log
db.sqlite3
db.sqlite3-journal

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini
